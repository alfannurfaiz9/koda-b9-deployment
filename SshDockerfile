FROM ubuntu:resolute

RUN apt-get update && apt-get install openssh-server -y

RUN useradd -ms /bin/bash alfan
RUN mkdir /home/alfan/.ssh
RUN chmod 700 /home/alfan/.ssh

COPY my-key.pub /home/alfan/.ssh/authorized_keys

RUN chown -R alfan:alfan /home/alfan/.ssh

RUN sed -i 's/#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config
RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin no/' /etc/ssh/sshd_config

CMD [ "sh", "-c", "service ssh start; tail -f /dev/null" ]
